{
  "name": "alpha-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "theme:generate": "node scripts/build-themes.mjs",
    "theme:check": "node scripts/build-themes.mjs --check && node scripts/check-theme-usage.mjs",
    "predev": "npm run theme:generate",
    "prebuild": "npm run theme:generate",
    "pretest": "npm run theme:check",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.112.3",
    "@use-gesture/react": "^10.3.1",
    "@vercel/functions": "^3.9.8",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
