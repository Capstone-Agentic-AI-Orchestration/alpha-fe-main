# =============================================================================
# Alpha Frontend — environment configuration
#
# Copy to `.env.local` and adjust. Gitignored; this file is committed.
#
# EVERY VITE_ VARIABLE IS PUBLIC
# ------------------------------
# Vite inlines any variable prefixed `VITE_` into the JavaScript bundle at
# build time. It is then visible to anyone who opens devtools or reads the
# deployed JS. The prefix is not a protection mechanism — it is the opposite,
# an explicit opt-in to publishing the value.
#
# A variable WITHOUT the prefix is simply not available to the app at all.
# So there is no such thing as a private frontend env var. Never put a secret
# in this file under any name.
# =============================================================================


# --- Local backend -----------------------------------------------------------

# Alpha's local API + WebSocket daemon. Must match PORT/HOST in the backend .env.
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001


# --- Supabase (OPTIONAL — team mode only) ------------------------------------
#
# Leave blank for solo mode: the app then talks only to the local daemon.

# Project URL. Public.
VITE_SUPABASE_URL=

# The ANON key. Public by design and safe to ship, but ONLY because Row Level
# Security constrains what it can read and write. Without RLS this key is full
# database access for anyone who views source.
#
# Confirm RLS is enabled before deploying: SUPABASE_AND_HOSTING_PLAN.md §2.5.7
# has a curl check that must return zero rows.
VITE_SUPABASE_ANON_KEY=

# There is no frontend equivalent of the service role key, and there must never
# be one. If a feature seems to need it, that feature belongs behind a Postgres
# `security definer` function or a server you control.
